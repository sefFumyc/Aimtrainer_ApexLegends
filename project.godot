; Engine configuration file.
; 锁定 Godot 4.7.2-stable + 纯 GDScript（ADR-0001）。
; 手写的 InputMap 见 [input]；三层结构（场景 / 纯逻辑 / Autoload 设置）见 ADR-0009。

config_version=5

[application]

config/name="Aim Trainer"
run/main_scene="res://src/scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
; 帧率兜底上限（修复 GPU 占用异常）：vsync 可能被驱动面板/系统层覆盖失效，
; 实测主菜单曾以 1200–2700 fps 裸奔把 GPU 打满、饿死桌面合成器。240 fps
; 下单帧 ~0.8ms → GPU 占用封顶 ~25%，任何环境下整机都不卡。
run/max_fps=240

[autoload]

GameSettings="*res://src/autoload/game_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; 显式声明垂直同步（默认值本就是它）：写出来是为了让「帧率上限靠 vsync、
; 失效靠 max_fps 兜底」的策略在项目配置里可见，防止后人误删。
window/vsync/vsync_mode=1

[input]

; 手柄动作键位可在设置「键位」页改绑（ADR-0025）：运行时由 GameSettings 用 GamepadBindings
; 回灌（只替换手柄事件、保留键鼠事件），下面的手柄事件只是与出厂默认表一致的初始值。
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
