; Engine configuration file.
; 锁定 Godot 4.7.2-stable + 纯 GDScript（ADR-0001）。
; 手写的 InputMap 见 [input]；三层结构（场景 / 纯逻辑 / Autoload 设置）见 ADR-0009。

config_version=5

[application]

config/name="Aim Trainer"
run/main_scene="res://src/scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameSettings="*res://src/autoload/game_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)]
}
crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194326), Object(InputEventKey,"device":-1,"physical_keycode":67), Object(InputEventJoypadButton,"device":-1,"button_index":1), Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
fire={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1), Object(InputEventJoypadButton,"device":-1,"button_index":10)]
}
ads={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2), Object(InputEventJoypadButton,"device":-1,"button_index":9)]
}
weapon_rifle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":49)]
}
weapon_pistol={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":50)]
}
weapon_switch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81), Object(InputEventJoypadButton,"device":-1,"button_index":3)]
}
end_round={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)]
}
toggle_settings={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}

[rendering]

renderer/rendering_method="forward_plus"